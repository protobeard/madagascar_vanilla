<?xml version="1.0" encoding="utf-8" ?>

<Patch>

    <!-- Disable Colonist Cremation -->

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>DisableColonistCremation</key>
        <match Class="PatchOperationRemove">

            <xpath>/Defs/RecipeDef[defName="CremateCorpse"]/defaultIngredientFilter/specialFiltersToAllow/li[text()="AllowCorpsesColonist"]</xpath>

        </match>
    </Operation>

</Patch>
