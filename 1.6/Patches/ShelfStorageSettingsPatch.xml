<?xml version="1.0" encoding="utf-8" ?>

<Patch>

    <!-- Empty Storage and Normal Priority -->

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableClearShelfStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/ThingDef[@Name="StorageShelfBase"]/building/defaultStorageSettings</xpath>
            <value>
                <defaultStorageSettings>
                    <priority>Normal</priority>
                    <filter>
                        <categories />
                    </filter>
                </defaultStorageSettings>
            </value>

        </match>
    </Operation>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableClearBookcaseStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/ThingDef[@Name="BookcaseBase"]/building/defaultStorageSettings</xpath>
            <value>
                <defaultStorageSettings>
                    <priority>Normal</priority>
                    <filter>
                        <categories />
                    </filter>
                </defaultStorageSettings>
            </value>

        </match>
    </Operation>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableClearHopperStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/ThingDef[defName="Hopper"]/building/defaultStorageSettings</xpath>
            <value>
                <defaultStorageSettings>
                    <priority>Normal</priority>
                    <filter>
                        <categories />
                    </filter>
                </defaultStorageSettings>
            </value>

        </match>
    </Operation>

    <!-- Disable Rotten -->

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>DisableRottenShelfStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/SpecialThingFilterDef[defName="AllowRotten"]/allowedByDefault</xpath>
            <value>
                <allowedByDefault>false</allowedByDefault>
            </value>

        </match>
    </Operation>

    <!-- Disable Deadmans -->

     <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>DisableDeadmansShelfStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/SpecialThingFilterDef[defName="AllowDeadmansApparel"]/allowedByDefault</xpath>
            <value>
                <allowedByDefault>false</allowedByDefault>
            </value>

        </match>
    </Operation>

    <!-- Disable Biocoded -->

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>DisableBiocodedShelfStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/SpecialThingFilterDef[defName="AllowBiocodedWeapons" or defName="AllowBiocodedApparel"]/allowedByDefault</xpath>
            <value>
                <allowedByDefault>false</allowedByDefault>
            </value>

        </match>
    </Operation>

</Patch>

