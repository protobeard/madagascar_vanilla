<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableHydroponicDevilstrand</key>
        <match Class="PatchOperationAdd">

            <xpath>/Defs/ThingDef[defName="Plant_Devilstrand"]/plant/sowTags</xpath>
            <value>
                <li>Hydroponic</li>
            </value>

        </match>
    </Operation>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableFalloutImmuneDevilstrand</key>
        <match Class="PatchOperationAdd">

            <xpath>/Defs/ThingDef[defName="Plant_Devilstrand"]/plant</xpath>
            <value>
                <dieFromToxicFallout>False</dieFromToxicFallout>
            </value>

        </match>
    </Operation>

</Patch>

