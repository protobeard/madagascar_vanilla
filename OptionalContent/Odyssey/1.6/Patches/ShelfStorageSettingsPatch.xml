<?xml version="1.0" encoding="utf-8" ?>

<Patch>

    <!-- Empty Storage and Normal Priority -->

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableClearOutfitStandStorage</key>
        <match Class="PatchOperationReplace">

            <xpath>/Defs/ThingDef[@Name="OutfitStandBase"]/building/defaultStorageSettings</xpath>
            <value>
                <defaultStorageSettings>
                    <priority>Normal</priority>
                    <filter>
                        <categories />
                    </filter>
                </defaultStorageSettings>
            </value>

        </match>
    </Operation>

</Patch>
