<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableFalloutImmuneToxipotatos</key>
        <match Class="PatchOperationAdd">

            <xpath>/Defs/ThingDef[defName="Plant_Toxipotato"]/plant</xpath>
            <value>
                <dieFromToxicFallout>False</dieFromToxicFallout>
            </value>

        </match>
    </Operation>

</Patch>
