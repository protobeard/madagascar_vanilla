<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="MadagascarVanilla.PatchOperations.OptionalPatch">
        <key>EnableNonflammableMechResourceChips</key>
        <match Class="PatchOperationAdd">

            <xpath>/Defs/ThingDef[@Name="MechResourceBase"]/statBases</xpath>
            <value>
                <Flammability>0</Flammability>
            </value>

        </match>
    </Operation>

</Patch>
